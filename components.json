{
  "$comment": "The template's optional components: what an API may remove (task component:remove -- <name>) and bring back (task component:add -- <name>). Each has a title, the components it needs, the files and directories (ending in /) it owns, and the gates it adds to a stage of task check (spec, implemented) and to task ci. Its sections of shared files are marked component:<name>:start and component:<name>:end; its Renovate rules have a description starting [component:<name>]; its entries in skills.json have \"component\": \"<name>\". template is where a removed component is restored from: point it at your own copy if you forked the template.",
  "template": {
    "repository": "https://github.com/hungovercoders/template-aws-api",
    "branch": "main"
  },
  "components": {
    "asyncapi": {
      "title": "The AsyncAPI contract (specs/contracts/asyncapi.yaml), its gates and the CloudEvents envelope: the messages an API receives and the events it publishes",
      "files": [
        "tools/asyncapi/",
        "rules/asyncapi.yaml",
        "test/asyncapi.test.ts",
        "src/lib/cloudevents.ts",
        "test/cloudevents.test.ts"
      ],
      "gates": {
        "install": [
          "asyncapi:install"
        ],
        "generate": [
          "asyncapi:generate"
        ],
        "spec": [
          "asyncapi:check",
          "asyncapi:lint",
          "asyncapi:compat",
          "asyncapi:examples:check"
        ],
        "ci": [
          "asyncapi:check",
          "asyncapi:lint",
          "asyncapi:compat",
          "asyncapi:examples:check"
        ]
      }
    },
    "consume": {
      "title": "Async input: the API takes messages from an SQS queue, each a receive operation of the AsyncAPI contract",
      "needs": [
        "asyncapi"
      ],
      "files": [
        "infra/consume.tf",
        "src/lib/consumer.ts",
        "src/consumer.ts",
        "scripts/consume.ts",
        "steps/messages.ts",
        "local/queue.ts",
        "test/consumer.test.ts",
        "test/consumers.test.ts",
        ".claude/skills/implement-api/messages.md"
      ],
      "gates": {
        "generate": [
          "consume:generate"
        ],
        "scaffold": [
          "consume:scaffold"
        ],
        "acceptance": [
          "consume:check"
        ]
      }
    },
    "publish": {
      "title": "Published events: what the API does is published to EventBridge through an outbox, each a send operation of the AsyncAPI contract",
      "needs": [
        "asyncapi"
      ],
      "files": [
        "infra/publish.tf",
        "src/lib/outbox.ts",
        "src/lib/forwarder.ts",
        "src/forwarder.ts",
        "scripts/publish.ts",
        "steps/events.ts",
        "local/events.ts",
        "test/forwarder.test.ts",
        ".claude/skills/implement-api/events.md",
        "tools/emulator/gaps/publish.ts",
        "tools/emulator/terraform/eventsv2-terraform/"
      ],
      "gates": {
        "generate": [
          "publish:generate"
        ],
        "acceptance": [
          "publish:check"
        ]
      }
    },
    "data": {
      "title": "Events as data: every published event is kept in S3 through Firehose, under an ODCS data contract (specs/contracts/datacontract.yaml) that drives the infrastructure and tests the data",
      "needs": [
        "publish"
      ],
      "files": [
        "infra/data.tf",
        "scripts/data.ts",
        "local/data.ts",
        "local/data_test.py",
        "rules/datacontract.yaml",
        "test/data.test.ts",
        "docs/data.md",
        ".claude/skills/write-spec/data.md",
        ".claude/skills/implement-api/data.md",
        "tools/emulator/gaps/data.ts",
        "tools/emulator/terraform/s3-control/",
        "tools/emulator/terraform/cloud-control-bucket-settings/",
        "src/compactor.ts",
        "src/lib/compactor.ts",
        "test/compactor.test.ts",
        "infra/tests/data.tftest.hcl",
        "infra/tests/data/"
      ],
      "gates": {
        "generate": [
          "data:layout"
        ],
        "spec": [
          "data:lint",
          "data:check",
          "data:compat"
        ],
        "ci": [
          "data:lint",
          "data:check",
          "data:compat"
        ],
        "acceptance": [
          "data:test"
        ]
      }
    }
  }
}
